{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    // Classic node ("node10") resolution, to keep CJS resolution behavior
    // identical. TS 6.0 no longer accepts an `ignoreDeprecations` value here —
    // passing one fails with TS5103 — so the acknowledgement is dropped.
    // Migrate to node16 when TS7 (which drops node10) is adopted.
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "./dist/cjs",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["src/**/*", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/__tests__/*", "**/private/**"]
}
