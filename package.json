{
  "name": "@voltras/node-sdk",
  "version": "0.11.0",
  "description": "SDK for connecting to and controlling Voltra fitness devices",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "browser": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/types/react/index.d.ts",
        "default": "./dist/esm/react/index.js"
      },
      "require": {
        "types": "./dist/types/react/index.d.ts",
        "default": "./dist/cjs/react/index.js"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/types/bluetooth/adapters/native.d.ts",
        "default": "./dist/esm/bluetooth/adapters/native.js"
      },
      "require": {
        "types": "./dist/types/bluetooth/adapters/native.d.ts",
        "default": "./dist/cjs/bluetooth/adapters/native.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/types/bluetooth/adapters/node.d.ts",
        "default": "./dist/esm/bluetooth/adapters/node.js"
      },
      "require": {
        "types": "./dist/types/bluetooth/adapters/node.d.ts",
        "default": "./dist/cjs/bluetooth/adapters/node.js"
      }
    },
    "./node-noble": {
      "import": {
        "types": "./dist/types/bluetooth/adapters/node-noble.d.ts",
        "default": "./dist/esm/bluetooth/adapters/node-noble.js"
      },
      "require": {
        "types": "./dist/types/bluetooth/adapters/node-noble.d.ts",
        "default": "./dist/cjs/bluetooth/adapters/node-noble.js"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/types/bluetooth/adapters/web.d.ts",
        "default": "./dist/esm/bluetooth/adapters/web.js"
      },
      "require": {
        "types": "./dist/types/bluetooth/adapters/web.d.ts",
        "default": "./dist/cjs/bluetooth/adapters/web.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/types/testing/index.d.ts",
        "default": "./dist/esm/testing/index.js"
      },
      "require": {
        "types": "./dist/types/testing/index.d.ts",
        "default": "./dist/cjs/testing/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:esm-pkg",
    "build:esm": "tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json --resolve-full-paths && node scripts/inject-esm-require-shim.mjs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm-pkg": "node -e \"require('node:fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'},null,2))\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "docs:api": "typedoc --out docs/api src/index.ts",
    "generate:protocol": "npx tsx ../voltra-private/build.ts",
    "ci:local": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "audit:privacy": "bash scripts/audit-privacy.sh",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native-ble-plx": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native-ble-plx": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@stoprocent/noble": "^2.5.3",
    "webbluetooth": "^3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@types/node": "^25.2.3",
    "@types/react": "^19.0.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.0",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.0",
    "tsc-alias": "^1.8.17",
    "typedoc": "^0.28.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^4.0.17"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "voltra",
    "bluetooth",
    "ble",
    "fitness",
    "sdk",
    "react-native",
    "node",
    "web-bluetooth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HJewkes/voltra-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/HJewkes/voltra-node-sdk/issues"
  },
  "homepage": "https://github.com/HJewkes/voltra-node-sdk#readme",
  "author": "Henry Jewkes (hjewkes@gmail.com)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
